JWT_SECRET_KEY=replace-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
# 目标坐标系（CGCS2000 3°高斯-克吕格投影 EPSG 4513-4533，4488+带号）。
# 安装初始化（scripts/install.ps1）时由部署人选择写入；首次启动固化进
# system_config 表后不可再改，改带须走全库投影迁移。默认 39 带（4527）。
TARGET_SRID=4527
