APP_NAME=Rural Land Contract Extension Platform
APP_VERSION=0.1.0
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=erlunyanbao
DATABASE_USER=RurallandContractExtension
DATABASE_PASSWORD=RurallandContractExtension
# JWT 密钥：install.ps1 安装时会自动生成随机密钥写入 backend/.env。
# 手动生成：python -c "import secrets; print('JWT_SECRET_KEY=' + secrets.token_urlsafe(48))"
# ⛔ 后端检测到公开默认值 replace-this-in-production 会拒绝启动（fail-fast）。
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
# 目标坐标系（CGCS2000 3°高斯-克吕格投影 EPSG 4513-4533，4488+带号）。
# 安装初始化（scripts/install.ps1）时由部署人选择写入；首次启动固化进
# system_config 表后不可再改，改带须走全库投影迁移。默认 39 带（4527）。
TARGET_SRID=4527
